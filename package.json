{
  "name": "reai-site-examples",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "./site.sh check all && npm run check:workers",
    "check:contract": "node tools/check-openapi.mjs",
    "check:workers": "wrangler deploy --dry-run --cwd sites/budmates && wrangler deploy --dry-run --cwd sites/endorphin",
    "sites": "./site.sh list",
    "deploy": "./site.sh deploy",
    "test": "node --test packages/reai-cloudflare-storefront/worker.test.mjs && ./validate.sh all"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  }
}
