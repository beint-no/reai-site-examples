{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "local-reai-storefront-template",
  "main": "worker.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "REAI_API_BASE_URL": "https://app.reai.no"
  }
}
