{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "budmates",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "main": "worker.js",
  "vars": {
    "REAI_BASE_URL": "https://app.reai.no"
  },
  // REAI_SITE_TOKEN is a Cloudflare secret scoped to the Budmates Site.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
